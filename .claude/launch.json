{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@devoh/server"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@devoh/web"],
      "port": 5173
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve@14", "-s", "apps/web/dist", "-l", "4173"],
      "port": 4173
    }
  ]
}
