{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@devoh/server"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@devoh/web"],
      "port": 5173
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/server.mjs"],
      "env": { "SERVER_INTERNAL_URL": "http://localhost:3001", "PORT": "4173" },
      "port": 4173
    }
  ]
}
