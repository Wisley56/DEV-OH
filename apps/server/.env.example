# Servidor de duelos — copie para .env (ignorado pelo git) e ajuste.
# Os valores abaixo são os padrões de desenvolvimento; todas são opcionais em dev.
# Em produção (NODE_ENV=production), as marcadas com [PRD] são obrigatórias: sem elas o server não sobe.
# Detalhes dos limites em SECURITY.md.

# Porta HTTP/Socket.IO.
PORT=3001

# Origens do web que podem conectar, separadas por vírgula. "*" libera tudo (só fora de produção).
CORS_ORIGIN=*

# [PRD] Proxies na frente do server: o IP real é o item (fim - N) do x-forwarded-for.
# 0 = sem proxy (dev). No Railway são 2: a borda do Railway e o server.mjs do web.
TRUST_PROXY_HOPS=0

# [PRD] Banco. Fora de produção: pglite://memory ou pglite://<pasta> (Postgres embutido).
DATABASE_URL=pglite://.data/dev
# [PRD] Conexões abertas com o banco.
DB_POOL_MAX=10
# [PRD] Validade da sessão de login (renovada enquanto a pessoa usa).
SESSION_TTL_DAYS=30

# [PRD] Cloudflare Turnstile (anti-robô do cadastro). Sem elas, valem as chaves de teste
# da Cloudflare, que sempre passam.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# [PRD] Arte das cartas do painel: Storage Bucket do Railway (S3). Sem ART_BUCKET, fora de produção
# a arte fica na pasta apps/server/.data/art.
# ART_BUCKET=
# ART_S3_ENDPOINT=
# ART_S3_REGION=
# ART_S3_ACCESS_KEY_ID=
# ART_S3_SECRET_ACCESS_KEY=
# Só para bucket antigo que pede path-style (veja a aba Credentials do bucket).
# ART_S3_FORCE_PATH_STYLE=false

# Sala sem atividade por esse tempo é removida (2 h).
ROOM_TTL_MS=7200000
# Sala sem ninguém conectado por esse tempo é removida (10 min).
ROOM_IDLE_TTL_MS=600000

# Limites contra abuso.
MAX_ROOMS=1000
MAX_CONN_PER_IP=20
RATE_CREATE_PER_MIN=5
RATE_JOIN_PER_MIN=10
RATE_ACTION_PER_SEC=10
RATE_AUTH_PER_MIN=10

# ── Produção (Railway: configure em Variables, não neste arquivo) ──
# NODE_ENV=production                       liga log em JSON e as exigências [PRD]
# CORS_ORIGIN=https://<url-do-web>          obrigatória, sem "*" e sem barra no final
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DB_POOL_MAX=10
# SESSION_TTL_DAYS=30
# TRUST_PROXY_HOPS=2
# TURNSTILE_SITE_KEY=<do painel da Cloudflare>
# TURNSTILE_SECRET_KEY=<do painel da Cloudflare>
# ART_BUCKET=${{Bucket.BUCKET}}               troque "Bucket" pelo nome do serviço do bucket
# ART_S3_ENDPOINT=${{Bucket.ENDPOINT}}
# ART_S3_REGION=${{Bucket.REGION}}
# ART_S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# ART_S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
