{
  "name": "dev-oh",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@devoh/server --filter=@devoh/web",
    "build": "turbo run build --filter=@devoh/web",
    "build:server": "turbo run build --filter=@devoh/server",
    "build:all": "turbo run build",
    "start:server": "npm run start -w @devoh/server",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "crop-art": "tsx scripts/crop-art.ts",
    "e2e": "npm run e2e -w @devoh/web"
  },
  "devDependencies": {
    "@devoh/eslint-config": "*",
    "@devoh/tsconfig": "*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.19.3",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.22"
  }
}
